## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
/bin
/obj
publish/
[Pp]ublish/

# Logs
[Ll]og/
[Ll]ogs/
*.log
InvoiceDesk/logs/

# User & IDE files
*.user
*.userossc
*.suo
*.userprefs
*.DotSettings.user
.vs/
.idea/
executable/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json

# Local databases and backups
*.mdf
*.ldf
*.bak

# Sensitive files
**/MyTopSecretInfos.txt

# .NET Core & NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg

# Scaffolding & Testing
ScaffoldingReadMe.txt
CodeCoverage/
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
.fake

# PDF exports & installer build artifacts
InvoiceDesk/Exports/Invoice-CHI1.pdf
InvoiceDesk/Exports/Invoice-DON2.pdf
InvoiceDesk/Exports/Invoice-DON3.pdf
tools/installer/Payloads/
tools/installer/Output/

# OS generated files
~$*
*~
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store